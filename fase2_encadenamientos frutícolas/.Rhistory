# ---------------------------------------------------------------------------
# AUXILIARES
# ---------------------------------------------------------------------------
to_num <- function(x) {
if (is.numeric(x)) return(x)
x <- str_trim(as.character(x))
out <- suppressWarnings(as.numeric(x))
if (mean(is.na(out[x != "" & !is.na(x)])) > 0.5)   # si falla: quitar miles
out <- suppressWarnings(as.numeric(str_remove_all(x, ",")))
out
}
