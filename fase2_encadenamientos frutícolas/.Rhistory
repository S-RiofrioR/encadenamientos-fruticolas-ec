}, error = function(e) NULL)
if (is.null(df) || nrow(df) == 0) next
claves <- c("ruc","ciiu","venta","compra","ingreso","activo",
"razon","nombre","provincia","actividad","periodo")
if (any(sapply(claves, function(k) any(grepl(k, tolower(names(df))))))) {
cat(sprintf("  Encabezado OK en fila %d | %d columnas | %d filas\n",
s + 1, ncol(df), nrow(df)))
return(df)
}
}
warning("No se detecto encabezado claro en: ", basename(ruta))
if (es_excel) read_excel(ruta, .name_repair = "minimal")
else read_csv(ruta, show_col_types = FALSE)
}
# ---------------------------------------------------------------------------
# 1. SUPERCias (Ranking de Companias)
# ---------------------------------------------------------------------------
leer_supercias <- function() {
if (length(arch_sup) == 0) {
warning("Sin archivo de Supercias; usando sintetico.")
return(generar_supercias_sintetico())
}
cat("\n[Supercias] Leyendo:", basename(arch_sup[1]), "\n")
df <- leer_con_encabezado(arch_sup[1])
cat("  Columnas:", paste(names(df), collapse = " | "), "\n")
col_ruc   <- detectar_col(df, c("ruc", "identificacion"))
col_razon <- detectar_col(df, c("razon_social", "nombre_compania", "nombre", "compania"))
col_ciiu  <- detectar_col(df, c("ciiu", "codigo_ciiu", "actividad"))
col_ventas<- detectar_col(df, c("ventas", "ingresos"))
col_activo<- detectar_col(df, c("activo"))
col_pasivo<- detectar_col(df, c("pasivo"))
col_patr  <- detectar_col(df, c("patrimonio"))
col_util  <- detectar_col(df, c("utilidad", "resultado"))
df_out <- tibble(
ruc          = if (!is.null(col_ruc)) normalizar_ruc(df[[col_ruc]]) else NA_character_,
razon_social = if (!is.null(col_razon)) as.character(df[[col_razon]]) else NA_character_,
ciiu4        = if (!is.null(col_ciiu)) extraer_ciiu4(df[[col_ciiu]]) else NA_character_,
ventas_netas = if (!is.null(col_ventas)) suppressWarnings(as.numeric(df[[col_ventas]])) else NA_real_,
activo_total = if (!is.null(col_activo)) suppressWarnings(as.numeric(df[[col_activo]])) else NA_real_,
pasivo_total = if (!is.null(col_pasivo)) suppressWarnings(as.numeric(df[[col_pasivo]])) else NA_real_,
patrimonio   = if (!is.null(col_patr))  suppressWarnings(as.numeric(df[[col_patr]]))  else NA_real_,
utilidad_neta= if (!is.null(col_util))  suppressWarnings(as.numeric(df[[col_util]]))  else NA_real_
)
df_frut <- df_out %>%
filter(!is.na(ruc), nchar(ruc) == 13, ciiu4 %in% CIIU_FRUTICOLA)
cat(sprintf("  Empresas totales leidas: %d\n", nrow(df_out)))
cat(sprintf("  Empresas FRUTICOLAS filtradas: %d\n", nrow(df_frut)))
if (nrow(df_frut) == 0) return(df_out)   # QA: devolver todo para inspeccion
df_frut
}
# ---------------------------------------------------------------------------
# 2. SRI (Ventas y Compras por CIIU y provincia)
# ---------------------------------------------------------------------------
leer_sri <- function() {
if (length(arch_sri) == 0) {
warning("Sin archivos SRI; usando sintetico.")
return(generar_sri_sintetico())
}
df_todo <- tibble()
for (arch in arch_sri) {
cat("\n[SRI] Leyendo:", basename(arch), "\n")
df <- tryCatch(leer_con_encabezado(arch), error = function(e) {
warning("Error leyendo ", basename(arch)); return(NULL)
})
if (is.null(df)) next
cat("  Columnas:", paste(names(df), collapse = " | "), "\n")
df$anio <- as.integer(str_extract(basename(arch), "\\d{4}"))
df_todo <- bind_rows(df_todo, df)
}
if (nrow(df_todo) == 0) return(generar_sri_sintetico())
col_ciiu  <- detectar_col(df_todo, c("ciiu", "codigo_actividad", "actividad"))
col_vent  <- detectar_col(df_todo, c("venta"))
col_comp  <- detectar_col(df_todo, c("compra"))
col_prov  <- detectar_col(df_todo, c("provincia"))
df_todo <- df_todo %>%
mutate(
ciiu4   = if (!is.null(col_ciiu)) extraer_ciiu4(!!sym(col_ciiu)) else NA_character_,
ventas  = if (!is.null(col_vent)) suppressWarnings(as.numeric(!!sym(col_vent))) else NA_real_,
compras = if (!is.null(col_comp)) suppressWarnings(as.numeric(!!sym(col_comp))) else NA_real_,
provincia = if (!is.null(col_prov)) as.character(!!sym(col_prov)) else NA_character_
)
df_frut <- df_todo %>%
filter(ciiu4 %in% CIIU_FRUTICOLA) %>%
group_by(ciiu4, anio) %>%
summarise(
ventas  = sum(ventas,  na.rm = TRUE),
compras = sum(compras, na.rm = TRUE),
margen_pct = round((ventas - compras) / pmax(ventas, 1) * 100, 2),
.groups = "drop"
)
cat(sprintf("\n  Registros SRI fruticolas agregados: %d\n", nrow(df_frut)))
if (nrow(df_frut) == 0) return(df_todo)
df_frut
}
# ---------------------------------------------------------------------------
# 3. FALLBACK SINTETICO (solo si no hay reales)
# ---------------------------------------------------------------------------
generar_supercias_sintetico <- function() {
set.seed(2025); n <- 250
tibble(
ruc = sprintf("%010d001", sample(17e8:18e8, n)),
razon_social = paste0(sample(c("AGROEXPORT","FRUTICOLA","TROPICAL","ANDES"),
n, replace = TRUE), " S.A. ", sample(1000:9999, n)),
ciiu4 = sample(CIIU_FRUTICOLA[1:4], n, replace = TRUE),
ventas_netas = round(exp(rnorm(n, log(5e6), 1.2)), 2),
activo_total = round(ventas_netas * runif(n, .8, 1.5), 2),
pasivo_total = activo_total * runif(n, .4, .7),
patrimonio = activo_total - pasivo_total,
utilidad_neta = round(activo_total * runif(n, .03, .15), 2)
)
}
generar_sri_sintetico <- function() {
set.seed(2025)
expand_grid(ciiu4 = CIIU_FRUTICOLA[1:6], anio = 2021:2024) %>%
mutate(ventas = round(runif(n(), 1e6, 80e6), 2),
compras = ventas * runif(n(), .55, .85),
margen_pct = round((ventas - compras) / ventas * 100, 2))
}
# ---------------------------------------------------------------------------
# 4. MAIN + QA + EXPORTACION
# ---------------------------------------------------------------------------
main <- function() {
df_sup <- leer_supercias()
df_sri <- leer_sri()
# QA: coherencia contable Activo = Pasivo + Patrimonio
if (all(c("activo_total","pasivo_total","patrimonio") %in% names(df_sup))) {
df_sup <- df_sup %>%
mutate(coherente = is.na(activo_total) |
abs(activo_total - (pasivo_total + patrimonio)) < pmax(activo_total,1) * 0.01)
cat(sprintf("\n[QA] Coherencia contable: %.1f%%\n",
100 * mean(df_sup$coherente, na.rm = TRUE)))
df_sup <- df_sup %>% filter(coherente | is.na(coherente))
}
cat("\n[Exportacion]\n")
if (nrow(df_sup) > 0) {
write_csv(df_sup, fs::path(PROC_DIR, "df_empresas_fruticolas.csv"))
cat(sprintf("  OK -> df_empresas_fruticolas.csv (%d filas)\n", nrow(df_sup)))
}
if (nrow(df_sri) > 0) {
write_csv(df_sri, fs::path(PROC_DIR, "df_sri_compras_ventas.csv"))
cat(sprintf("  OK -> df_sri_compras_ventas.csv (%d filas)\n", nrow(df_sri)))
}
cat("\n=== ETL v3 COMPLETADO ===\n")
}
main()
